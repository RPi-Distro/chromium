+#if BUILDFLAG(USE_V4L2_CODEC)
+// The V4L2 decoder walks /dev/video* for a device it can drive, both when
+// enumerating supported configs and again when playback starts, but the Linux
+// broker policy only knows the ChromeOS /dev/video-dec* names - see
+// AddV4L2GpuPermissions(), which is only reached on ChromeOS and Chromecast.
+// On a Raspberry Pi the decoder is /dev/video10, so every open is refused and
+// playback drops to software with no diagnostic. Grant the decoder nodes here,
+// while the hook is still unsandboxed, reusing the media layer's own
+// enumeration so the sandbox policy cannot drift from the device the decoder
+// will actually pick.
+// libgbm resolves its backend lazily, on the first native pixmap import. Under
+// X11 that import is NativePixmapEGLX11Binding, which runs long after the
+// sandbox has closed, so the dlopen is refused:
+//
+//   MESA-LOADER: failed to open dri: /usr/lib/<triplet>/gbm/dri_gbm.so:
+//   cannot open shared object file: Permission denied
+//
+// Native pixmap support is then unavailable and video decode never starts, so
+// the decoder permission granted below is wasted. Both a broker permission and
+// a pre-sandbox load are needed, as for libmali.so: brokering alone fails on
+// the backend's own dependencies (libwayland-server.so.0), and loading alone
+// fails because glibc must open() the requested path to notice the library is
+// already resident - and dlinfo() reports the /lib spelling on merged-/usr
+// systems while mesa asks for /usr/lib.
+//
+// The directory comes from libgbm's own location rather than a hard-coded
+// multiarch path, and every backend found is used rather than naming
+// dri_gbm.so.
+std::vector<base::FilePath> GetGbmBackendPaths() {
+  std::vector<base::FilePath> paths;
+  void* gbm = dlopen("libgbm.so.1", dlopen_flag);
+  if (!gbm) {
+    return paths;
+  }
+  char origin[PATH_MAX];
+  if (dlinfo(gbm, RTLD_DI_ORIGIN, origin) != 0) {
+    LOG(WARNING) << "Could not locate libgbm; GBM backends unavailable";
+    return paths;
+  }
+  base::FileEnumerator backends(base::FilePath(origin).Append("gbm"),
+                                /*recursive=*/false,
+                                base::FileEnumerator::FILES,
+                                FILE_PATH_LITERAL("*.so"));
+  for (base::FilePath path = backends.Next(); !path.empty();
+       path = backends.Next()) {
+    paths.push_back(path);
+    // The broker matches the path as requested, so allow both spellings.
+    const base::FilePath resolved = base::MakeAbsoluteFilePath(path);
+    if (!resolved.empty() && resolved != path) {
+      paths.push_back(resolved);
+    }
+  }
+  return paths;
+}
+
+void AddGbmBackendPermissions(std::vector<BrokerFilePermission>* permissions) {
+  for (const base::FilePath& path : GetGbmBackendPaths()) {
+    VLOG(1) << "Allowing sandboxed access to GBM backend " << path;
+    permissions->push_back(BrokerFilePermission::ReadOnly(path.value()));
+  }
+}
+
+// Resolves each backend's dependency tree while we are still unsandboxed.
+void LoadGbmBackends() {
+  for (const base::FilePath& path : GetGbmBackendPaths()) {
+    if (dlopen(path.value().c_str(), dlopen_flag)) {
+      VLOG(1) << "Preloaded GBM backend " << path;
+    } else {
+      LOG(WARNING) << "Failed to preload GBM backend " << path << ": "
+                   << dlerror();
+    }
+  }
+}
+
+void AddLinuxV4L2DecoderPermissions(
+    std::vector<BrokerFilePermission>* permissions) {
+  for (const auto& path : media::V4L2Device::GetDecoderDevicePaths()) {
+    VLOG(1) << "Allowing sandboxed access to V4L2 decoder " << path;
+    permissions->push_back(BrokerFilePermission::ReadWrite(path));
+  }
+}
+#endif  // BUILDFLAG(USE_V4L2_CODEC)
+
 void AddArmMaliGpuPermissions(std::vector<BrokerFilePermission>* permissions) {
   // Device file needed by the ARM GPU userspace.
   static const char kMali0Path[] = "/dev/mali0";
