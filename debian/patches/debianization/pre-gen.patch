         pass
+      # Debian filtering
+      elif deb_clang_target and args[i].startswith('--target='):
+        yield f'--target={deb_clang_target}'
+      elif deb_clang_target and args[i].startswith('-W'):
+        pass
+      elif deb_clang_target and args[i].startswith('-f') and args[i] != '-fparse-all-comments':
+        pass
+      elif deb_clang_target and args[i] == '-mllvm':
+        i += 1
+      elif deb_clang_target and args[i].startswith('-m'):
+        pass
       else:
         yield args[i]
       i += 1
