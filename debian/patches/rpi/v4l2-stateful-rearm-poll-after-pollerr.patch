+
+void V4L2StatefulVideoDecoder::CancelCAPTUREQueueMonitoring() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  weak_ptr_factory_for_events_.InvalidateWeakPtrs();
+  weak_ptr_factory_for_CAPTURE_availability_.InvalidateWeakPtrs();
+  cancelable_task_tracker_.TryCancelAll();
+  // The invalidated WeakPtrs drop the result callbacks of any in-flight
+  // WaitOnceForEvents() tasks, so forget them here as well. Note this does not
+  // stop a task already blocked in poll(): |pending_poll_tasks_| counts result
+  // callbacks we still expect, not tasks that are still running.
+  pending_poll_tasks_ = 0;
+  consecutive_fruitless_rearms_ = 0;
+  rearm_limit_reported_ = false;
+}
+
+void V4L2StatefulVideoDecoder::ArmCAPTUREQueueMonitoringIfIdle() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Called by |OUTPUT_queue_| and |CAPTURE_queue_| after a QBUF, after a DQBUF
+  // that leaves buffers queued, and when DQBUF returns EAGAIN/EPIPE. The first
+  // OUTPUT buffers are queued before |event_task_runner_| exists; Decode()
+  // arms monitoring itself right after creating it.
+  //
+  // V4L2Queue calls this from inside its own QBUF/DQBUF handling, while its
+  // bookkeeping is half updated, so nothing here may call back into a queue.
+  // IsInitialized() implies an open |device_fd_|: it is opened before
+  // |OUTPUT_queue_| is created, and only Reset() and the destructor close it,
+  // dropping both.
+  if (pending_poll_tasks_ > 0 || !IsInitialized() || !event_task_runner_) {
+    return;
+  }
+  RearmCAPTUREQueueMonitoring();
+}
+
+void V4L2StatefulVideoDecoder::OnCAPTUREQueuePollDone(int revents) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // The two directions are not symmetric: a count left too high disables both
+  // re-arming paths for good, while one left too low only costs an extra poll
+  // task, so clamp rather than risk the former in release builds.
+  DCHECK_GT(pending_poll_tasks_, 0);
+  if (pending_poll_tasks_ > 0) {
+    --pending_poll_tasks_;
+  }
+
+  if (revents & (POLLIN | POLLPRI)) {
+    // The device made progress, so any run of fruitless re-arms is over. Note
+    // the kernel can return POLLERR alongside POLLPRI, so test this first.
+    consecutive_fruitless_rearms_ = 0;
+    rearm_limit_reported_ = false;
+  }
+  if (revents & POLLPRI) {
+    // A resolution change. The client has been asked to prepare for it and
+    // will call ApplyResolutionChange(), whose InitializeCAPTUREQueue() arms
+    // monitoring again; until then the device stays unwatched, as upstream.
+    return;
+  }
+  if (pending_poll_tasks_ > 0 || !IsInitialized()) {
+    return;
+  }
+
+  // Nothing is watching |device_fd_| any more. Usually the dequeue callback
+  // has re-armed it before we get here, but not on every path:
+  // TryAndDequeueCAPTUREQueueBuffers() returns early on a LAST buffer while
+  // the OUTPUT queue still has work, WaitOnceForEvents() returns early if
+  // VIDIOC_DQEVENT fails, and a poll() that returned POLLERR or failed
+  // outright never re-arms by itself. If the driver still owns buffers then
+  // something is going to happen on them, so watch again. If it owns none
+  // there is nothing to wait for, any run of fruitless polls is over, and the
+  // next QBUF arms us through ArmCAPTUREQueueMonitoringIfIdle().
+  const bool driver_owns_buffers =
+      OUTPUT_queue_->QueuedBuffersCount() > 0 ||
+      (CAPTURE_queue_ && CAPTURE_queue_->QueuedBuffersCount() > 0);
+  if (!driver_owns_buffers) {
+    consecutive_fruitless_rearms_ = 0;
+    rearm_limit_reported_ = false;
+    return;
+  }
+  if (revents & POLLIN) {
+    RearmCAPTUREQueueMonitoring();
+    return;
+  }
+
+  // POLLERR, POLLHUP/POLLNVAL, or a poll() that made no progress. A V4L2
+  // memory-to-memory device returns POLLERR when, for each queue, the queue is
+  // not streaming, or vb2_queue_error() has been called on it, or it has
+  // nothing queued (v4l2_m2m_poll_for_data()). The last of those is the normal
+  // transient state here and is already handled above, since the driver then
+  // owns nothing; a queue in error keeps returning POLLERR even with buffers
+  // queued, which is what this cap is for. All of these return immediately.
+  if (consecutive_fruitless_rearms_ >= kMaxFruitlessRearms) {
+    if (!rearm_limit_reported_) {
+      rearm_limit_reported_ = true;
+      constexpr char kMessage[] =
+          "poll() keeps returning without data while the driver owns buffers; "
+          "no longer re-arming |CAPTURE_queue_| monitoring.";
+      LOG(ERROR) << kMessage;
+      MEDIA_LOG(ERROR, media_log_) << kMessage;
+    }
+    // Only a later POLLIN/POLLPRI clears this; until then the decoder relies
+    // on QBUF-driven arming alone. There is no error callback to our client,
+    // so fail what we can rather than leave it waiting: a pending flush and
+    // any Decode() not yet answered, as Reset() does with kAborted.
+    if (flush_cb_) {
+      std::move(flush_cb_).Run(DecoderStatus::Codes::kFailed);
+    }
+    while (!decoder_buffer_and_callbacks_.empty()) {
+      auto media_decode_cb =
+          std::move(decoder_buffer_and_callbacks_.front().second);
+      decoder_buffer_and_callbacks_.pop();
+      std::move(media_decode_cb).Run(DecoderStatus::Codes::kFailed);
+    }
+    return;
+  }
+  ++consecutive_fruitless_rearms_;
+  RearmCAPTUREQueueMonitoring();
 }
 
