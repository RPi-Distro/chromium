Index: chromium-151.0.7922.47/build/config/compiler_cpu_abi.gn
===================================================================
--- chromium-151.0.7922.47.orig/build/config/compiler_cpu_abi.gn
+++ chromium-151.0.7922.47/build/config/compiler_cpu_abi.gn
@@ -52,7 +52,7 @@ if ((is_posix && !is_apple) || is_fuchsi
       cpu_abi_cflags += [ "--target=x86_64-unknown-linux-gnu" ]
       cpu_abi_ldflags += [ "--target=x86_64-unknown-linux-gnu" ]
     } else {
-      cpu_abi_cflags += [ "-m64" ]
+      cpu_abi_cflags += [ "-m64", "-mcpu=power9", "-mtune=power9" ]
       cpu_abi_ldflags += [ "-m64" ]
     }
     cpu_abi_cflags += [ "-msse3" ]
