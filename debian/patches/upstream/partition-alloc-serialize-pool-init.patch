@@ -47,6 +48,24 @@ namespace partition_alloc::internal {
 
 namespace {
 
+// Serializes the initialization of the pools, which is process-wide state.
+//
+// The callers cannot do it: `Init()` and `InitThreadIsolatedPool()` are
+// reached from `PartitionRoot::Init()`, which holds the lock of the root it is
+// initializing. Two roots initializing on two threads hold two different
+// locks, so both pass the `IsInitialized()` test at the top of `Init()`, and
+// `AddressPoolManager::Add()` then fails `PA_CHECK(!pool->IsInitialized())` in
+// whichever thread gets there second. A component build makes this easy to
+// hit, because a root is created lazily per library rather than once, early,
+// on the main thread.
+//
+// Holding this lock around the whole of the initialization is safe: it
+// reserves address space with `AllocPages()` and releases it with
+// `FreePages()`, allocating nothing, which is what already allows the same
+// code to run under `PartitionRoot::lock_`. It is never held while calling
+// into a `PartitionRoot`, so it cannot be part of a cycle.
+Lock g_pool_init_lock;
+
 #if PA_BUILDFLAG(IS_WIN)
 
 PA_NOINLINE void HandlePoolAllocFailureOutOfVASpace() {
@@ -144,6 +163,7 @@ bool PartitionAddressSpace::IsIOSTestProcess() {
 #endif  // PA_CONFIG(DYNAMICALLY_SELECT_POOL_SIZE)
 
 void PartitionAddressSpace::Init() {
+  ScopedGuard guard(g_pool_init_lock);
   if (IsInitialized()) {
     return;
   }
@@ -324,6 +344,8 @@ void PartitionAddressSpace::InitZeroSegment() {
 
 void PartitionAddressSpace::InitConfigurablePool(uintptr_t pool_base,
                                                  size_t size) {
+  ScopedGuard guard(g_pool_init_lock);
+
   // The ConfigurablePool must only be initialized once.
   PA_CHECK(!IsConfigurablePoolInitialized());
 
@@ -374,6 +396,8 @@ void PartitionAddressSpace::InitConfigurablePool(uintptr_t pool_base,
 #if PA_BUILDFLAG(ENABLE_THREAD_ISOLATION)
