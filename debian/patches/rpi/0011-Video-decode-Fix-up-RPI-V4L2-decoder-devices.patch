From bd9156fbb26d41d79d530587a13a4d3d9c604399 Mon Sep 17 00:00:00 2001
From: John Cox <jc@kynesim.co.uk>
Date: Mon, 20 May 2024 17:39:07 +0100
Subject: [PATCH 11/17] Video decode: Fix up RPI V4L2 decoder devices

---
 media/gpu/v4l2/v4l2_device.cc | 12 ++++++++++++
 media/gpu/v4l2/v4l2_utils.cc  | 12 ++++++++++++
 2 files changed, 24 insertions(+)

--- a/media/gpu/v4l2/v4l2_device.cc
+++ b/media/gpu/v4l2/v4l2_device.cc
@@ -912,7 +912,11 @@ void V4L2Device::EnumerateDevicesForType
   constexpr int kMaxDevices = 256;
   candidate_paths.reserve(kMaxDevices);
 #endif
+#if BUILDFLAG(USE_V4L2_CODEC_RPI)
+  for (int i = 10; i < 35; ++i) {
+#else
   for (int i = 0; i < kMaxDevices; ++i) {
+#endif
     candidate_paths.push_back(
         base::StringPrintf("%s%d", device_pattern.c_str(), i));
   }
--- a/media/gpu/v4l2/v4l2_utils.cc
+++ b/media/gpu/v4l2/v4l2_utils.cc
@@ -574,6 +574,11 @@ std::optional<SupportedVideoDecoderConfi
 #if BUILDFLAG(IS_CHROMEOS)
   constexpr char kVideoDevicePattern[] = "/dev/video-dec0";
   candidate_paths.push_back(kVideoDevicePattern);
+#elif BUILDFLAG(USE_V4L2_CODEC_RPI)
+  // Pi stateful decoder here  current google code doesn't look like it can
+  // cope with multiple devioces
+  constexpr char kVideoDevicePattern[] = "/dev/video10";
+  candidate_paths.push_back(kVideoDevicePattern);
 #else
   constexpr char kVideoDevicePattern[] = "/dev/video";
   constexpr int kMaxDevices = 256;
@@ -632,7 +637,13 @@ std::optional<SupportedVideoDecoderConfi
 }
 
 bool IsV4L2DecoderStateful() {
+#if !BUILDFLAG(USE_V4L2_CODEC_RPI)
   constexpr char kVideoDeviceDriverPath[] = "/dev/video-dec0";
+#else
+  // Pi stateful decoder here  current google code doesn't look like it can
+  // cope with multiple devioces
+  constexpr char kVideoDeviceDriverPath[] = "/dev/video10";
+#endif
   base::ScopedFD device_fd(HANDLE_EINTR(
       open(kVideoDeviceDriverPath, O_RDWR | O_NONBLOCK | O_CLOEXEC)));
   if (!device_fd.is_valid()) {
