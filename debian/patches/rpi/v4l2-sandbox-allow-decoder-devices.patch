+std::vector<std::string> V4L2Device::GetDecoderDevicePaths() {
+  std::vector<std::string> paths;
+  auto dev = base::MakeRefCounted<V4L2Device>();
+  for (const auto& device : dev->GetDevicesForType(Type::kDecoder)) {
+    paths.push_back(device.first);
+  }
+  return paths;
+}
