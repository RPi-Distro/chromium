--- a/media/gpu/v4l2/v4l2_stateful_video_decoder.cc
+++ b/media/gpu/v4l2/v4l2_stateful_video_decoder.cc
@@ -280,18 +280,32 @@ void V4L2StatefulVideoDecoder::Initializ
     return;
   }
 
+  // The device fd is only ever open while this object holds a slot in
+  // |num_decoder_instances_|: the slot is taken before the fd is opened, and
+  // only Reset(), after it has closed the fd, and the destructor, while tearing
+  // down, give it back.
+  DCHECK(!device_fd_.is_valid() || holds_instance_slot_);
+
   // Verify there's still room for more decoders before querying whether
   // |config| is supported because some drivers (e.g. Qualcomm Venus on SC7180)
   // would not allow for opening the device fd and we'd think it an error.
   static const auto decoder_instances_limit =
       V4L2StatefulVideoDecoder::GetMaxNumDecoderInstances();
-  const bool can_create_decoder =
-      num_decoder_instances_.Increment() < decoder_instances_limit;
-  if (!can_create_decoder) {
-    num_decoder_instances_.Decrement();
-    LOG(ERROR) << "Too many decoder instances, max=" << decoder_instances_limit;
-    std::move(init_cb).Run(DecoderStatus::Codes::kTooManyDecoders);
-    return;
+  // Skip the check if this object already holds a slot: a re-Initialize() for
+  // a track change, or Decode()'s retry after a failed one. Unlike
+  // V4L2VideoDecoder the slot is kept rather than released and re-taken, so
+  // that a track change at the limit no longer fails with kTooManyDecoders.
+  if (!holds_instance_slot_) {
+    const bool can_create_decoder =
+        num_decoder_instances_.Increment() < decoder_instances_limit;
+    if (!can_create_decoder) {
+      num_decoder_instances_.Decrement();
+      LOG(ERROR) << "Too many decoder instances, max="
+                 << decoder_instances_limit;
+      std::move(init_cb).Run(DecoderStatus::Codes::kTooManyDecoders);
+      return;
+    }
+    holds_instance_slot_ = true;
   }
 
   if (supported_configs_.empty()) {
@@ -580,7 +594,7 @@ void V4L2StatefulVideoDecoder::Reset(bas
   device_fd_.reset();
 
   event_task_runner_.reset();
-  num_decoder_instances_.Decrement();
+  ReleaseInstanceSlot();
   encoding_timestamps_.clear();
 
   if (flush_cb_) {
@@ -666,7 +680,7 @@ V4L2StatefulVideoDecoder::~V4L2StatefulV
 
   CAPTURE_queue_.reset();
   OUTPUT_queue_.reset();
-  num_decoder_instances_.Decrement();
+  ReleaseInstanceSlot();
 
   if (event_task_runner_) {
     // Destroy the two ScopedFDs (hence the PostTask business ISO DeleteSoon) on
@@ -1207,6 +1221,19 @@ bool V4L2StatefulVideoDecoder::IsInitial
   return !!OUTPUT_queue_;
 }
 
+void V4L2StatefulVideoDecoder::ReleaseInstanceSlot() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!holds_instance_slot_) {
+    return;
+  }
+  holds_instance_slot_ = false;
+  // A tripwire for a decrement added later without the flag guard: this class
+  // can no longer drive the count negative by itself, and each spurious
+  // decrement permanently raises the effective limit by one.
+  DCHECK_GT(num_decoder_instances_.SubtleRefCountForDebug(), 0);
+  num_decoder_instances_.Decrement();
+}
